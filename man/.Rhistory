devtools::document()
devtools::install()
library(TrackTrap)
crs_trap_data <- data.frame(
date = seq(as.Date("2026-03-01"), as.Date("2026-05-20"), by = "weeks"),
trap_counts = sample(5:30, 12, replace = TRUE)
)
crs_trap_data$trap_counts[1:2]<-0
pheno_data <- TrackTrap::calc_pest_phenology(
trap_data      = crs_trap_data,
pest           = "CM",
lat            = 36.321,
lon            = -119.543,
weather_source = "open_meteo"
)
TrackTrap::plot_trap_phenology(
pheno_data,
pest = "CM"
)
devtools::check(cran = TRUE)
# Create the data-raw directory if it doesn't already exist
dir.create("data-raw", showWarnings = FALSE)
# Move the script out of the root directory
file.rename("pest_thresholds.R", "data-raw/pest_thresholds.R")
# Tell CRAN to ignore the data-raw folder
usethis::use_build_ignore("data-raw")
devtools::check(cran = TRUE)
usethis::use_build_ignore("data-raw")
devtools::check(cran = TRUE)
devtools::release()
devtools::release()
devtools::release()
devtools::release()
