Package: TrackTrap
Title: Calculate and Visualize Degree-Days for Pest Monitoring
Version: 1.1.0
Authors@R: c(
    person("Santosh", "Bhandari",
        email = "santoshbhandari4556@gmail.com",
        role = c("aut", "cre")),
    person("Lalit", "Kharel",
