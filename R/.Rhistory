# 1. built package
library(TrackTrap)
library(tidyverse)
library(lubridate)
# 2. Load data/dataset
#my_trap_data <- data.frame(
#date = c("2025-03-01", "2025-03-15", "2025-04-01", "2025-04-15", "2025-05-01", "2025-05-15"),
#trap_counts = c(0, 2, 5, 20, 85, 40)
#)
my_trap_data <- read.csv("C:/Users/UCCETC1/Downloads/north_sac_valley_2011_2024_with_coords_and_date.csv")
my_trap_data$date <- mdy(my_trap_data$date)
my_trap_data <- my_trap_data %>% arrange(Location, date)
single_loc_data <- my_trap_data %>%
filter(Location == "Dora and Marguerite-Treated") %>%
arrange(date)
print(paste("Processing", nrow(single_loc_data), "rows for this location."))
pheno_data <- TrackTrap::calc_pest_phenology(
trap_data = single_loc_data,
pest = "NOW",
lat = single_loc_data$lat[1],
lon= single_loc_data$lon[1])
# 4. Look at the calculated data
print("Phenology Data Calculated:")
head(pheno_data)
# 5. Generate and view the plot
my_plot <- TrackTrap::plot_phenology_trend(pheno_data, save_plot = FALSE)
# Display the plot in the RStudio Viewer
print(my_plot)
filtered_loc_data <- my_trap_data %>%
filter(Location == "Dora and Marguerite-Treated") %>%
arrange(date)
print(paste("Processing", nrow(single_loc_data), "rows for this location."))
pheno_data <- TrackTrap::calc_pest_phenology(
trap_data = filtered_loc_data,
pest = "NOW",
lat = single_loc_data$lat[1],
lon= single_loc_data$lon[1])
# 4. Look at the calculated data
print("Phenology Data Calculated:")
head(pheno_data)
# 5. Generate and view the plot
my_plot <- TrackTrap::plot_phenology_trend(pheno_data, save_plot = FALSE)
# Display the plot in the RStudio Viewer
print(my_plot)
