library(TrackTrap)
crs_trap_data <- data.frame(
date = seq(as.Date("2026-03-10"), as.Date("2026-05-20"), by="weeks"),
trap_counts = c(10, 150, 50, 20, 10, 5, 8, 300, 120, 40, 15)
)
pheno_data <- TrackTrap::calc_pest_phenology(
trap_data = crs_trap_data,
pest = "CRS",
lat = 36.321,
lon = -119.543
)
head(pheno_data)
pheno_data <- TrackTrap::calc_pest_phenology(
trap_data = crs_trap_data,
pest = "CRS",
lat = 35.3935,
lon = -119.0437
)
